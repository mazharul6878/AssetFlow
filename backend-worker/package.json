{
  "name": "assetflow-backend-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker Backend for AssetFlow Fixed Asset Verification System",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:control:local": "wrangler d1 execute CONTROL_DB --local --file=./migrations/control/0001_initial_control.sql",
    "db:migrate:shard:local": "wrangler d1 execute SHARD_01 --local --file=./migrations/shard/0001_initial_shard.sql"
  },
  "keywords": [
    "assetflow",
    "cloudflare-worker",
    "d1",
    "sqlite",
    "sharding"
  ],
  "author": "AssetFlow Team",
  "license": "UNLICENSED",
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "wrangler": "4.156.0"
  }
}
