      (!('fiscalYearId' in data) || (data.fiscalYearId is string && data.fiscalYearId.size() <= 60)) &&
      data.fieldsJson is string && data.fieldsJson.size() <= 250000 &&
      data.changeSummary is string && data.changeSummary.size() <= 2000 &&
      data.createdByUid is string && data.createdByUid.size() <= 128 &&
      data.createdByName is string && data.createdByName.size() <= 150 &&
      data.publishedByUid is string && data.publishedByUid.size() <= 128 &&
      data.publishedByName is string && data.publishedByName.size() <= 150 &&
      data.createdAtIso is string && data.createdAtIso.size() <= 60 &&
      data.publishedAtIso is string && data.publishedAtIso.size() <= 60 &&
      data.previousVersionId is string && data.previousVersionId.size() <= 128 &&
      data.userId is string && data.userId == workspaceId &&
      data.createdAt is timestamp && data.createdAt <= request.time &&
      data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserSubmissionRecord(data, ownerUid) {
      return data.keys().hasAll([
        'submissionId', 'submitterUid', 'submitterName', 'nicknameSnapshot',
        'workspaceId', 'assetKey', 'assetId', 'sourceRow', 'worksheetName',
        'schemaVersionId', 'schemaVersionNumber', 'submissionStatus',
        'fieldValuesJson', 'fixedFieldSnapshotJson', 'photoIdsCsv',
        'reviewNotes', 'rejectionReason', 'reviewedByUid', 'reviewedByName', 'reviewedAtIso',
        'publishedWorkbookVersion', 'publishedAtIso', 'publishedByUid', 'publishedByName',
        'publishedAuditLogId', 'syncErrorMessage', 'auditHistory',
        'userId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'submissionId', 'submitterUid', 'submitterName', 'nicknameSnapshot',
        'workspaceId', 'clientId', 'fiscalYearId',
        'assetKey', 'assetId', 'sourceRow', 'worksheetName',
        'schemaVersionId', 'schemaVersionNumber', 'submissionStatus',
        'fieldValuesJson', 'fixedFieldSnapshotJson', 'photoIdsCsv',
        'reviewNotes', 'rejectionReason', 'reviewedByUid', 'reviewedByName', 'reviewedAtIso',
        'publishedWorkbookVersion', 'publishedAtIso', 'publishedByUid', 'publishedByName',
        'publishedAuditLogId', 'syncErrorMessage', 'auditHistory',
        'userId', 'createdAt', 'updatedAt'
      ]) &&
      data.submissionId is string && data.submissionId.size() >= 1 && data.submissionId.size() <= 128 &&
      data.submitterUid is string && data.submitterUid == ownerUid &&
      data.submitterName is string && data.submitterName.size() <= 150 &&
      data.nicknameSnapshot is string && data.nicknameSnapshot.size() <= 60 &&
      data.workspaceId is string && data.workspaceId.size() >= 1 && data.workspaceId.size() <= 128 &&
      (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
      (!('fiscalYearId' in data) || (data.fiscalYearId is string && data.fiscalYearId.size() <= 60)) &&
      isTeamMember(data.workspaceId) &&
      data.assetKey is string && data.assetKey.size() >= 1 && data.assetKey.size() <= 128 &&
      data.assetId is string && data.assetId.size() >= 1 && data.assetId.size() <= 100 &&
      data.sourceRow is int && data.sourceRow >= 1 &&
      data.worksheetName is string && data.worksheetName.size() <= 128 &&
      data.schemaVersionId is string && data.schemaVersionId.size() <= 128 &&
      data.schemaVersionNumber is int && data.schemaVersionNumber >= 1 &&
      data.submissionStatus is string && data.submissionStatus in [
        'Draft',
        'Pending Review',
        'Changes Requested',
        'Rejected',
        'Approved — Awaiting Master Update',
        'Master Update In Progress',
        'Sync Failed',
        'Published'
      ] &&
      data.fieldValuesJson is string && data.fieldValuesJson.size() <= 50000 &&
      data.fixedFieldSnapshotJson is string && data.fixedFieldSnapshotJson.size() <= 20000 &&
      data.photoIdsCsv is string && data.photoIdsCsv.size() <= 4000 &&
      data.reviewNotes is string && data.reviewNotes.size() <= 2000 &&
      data.rejectionReason is string && data.rejectionReason.size() <= 2000 &&
      data.reviewedByUid is string && data.reviewedByUid.size() <= 128 &&
      data.reviewedByName is string && data.reviewedByName.size() <= 150 &&
      data.reviewedAtIso is string && data.reviewedAtIso.size() <= 60 &&
      data.publishedWorkbookVersion is int && data.publishedWorkbookVersion >= 0 &&
      data.publishedAtIso is string && data.publishedAtIso.size() <= 60 &&
      data.publishedByUid is string && data.publishedByUid.size() <= 128 &&
      data.publishedByName is string && data.publishedByName.size() <= 150 &&
      data.publishedAuditLogId is string && data.publishedAuditLogId.size() <= 128 &&
      data.syncErrorMessage is string && data.syncErrorMessage.size() <= 1000 &&
      data.auditHistory is string && data.auditHistory.size() <= 8000 &&
      data.userId is string && data.userId == ownerUid &&
      data.createdAt is timestamp && data.createdAt <= request.time &&
      data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/system_config/{configId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(configId) &&
                       !exists(/databases/$(database)/documents/users/$(userId)/system_config/ownership) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().userId == userId;
      allow update: if isInitialOwnerForWorkspace(userId) && isValidId(configId) &&
                       incoming().ownerUid == existing().ownerUid;
      allow delete: if false;
    }

    match /users/{userId}/user_profile/{profileId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdminForWorkspace(userId)) && isValidId(profileId);
      allow list: if isSignedIn() && (request.auth.uid == userId && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(profileId) &&
                       isNotDeletedIdentity(userId) &&
                       (isValidSelfUserProfile(incoming(), userId) ||
                        (isAdminForWorkspace(userId) && isValidUserProfile(incoming(), userId)));
      allow update: if isSignedIn() && isNotDeletedIdentity(userId) &&
                       (isValidSelfUserProfileUpdate(incoming(), existing(), userId) ||
                        (isAdminForWorkspace(userId) && isValidUserProfile(incoming(), userId))) &&
                       (request.auth.uid == userId || isAdminForWorkspace(userId)) && isValidId(profileId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'fullName', 'nickname', 'email', 'role', 'accountStatus', 'updatedAt'
                       ]);
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdminForWorkspace(userId)) && isValidId(profileId);
    }

    match /users/{userId}/role_assignments/{memberUid} {
      allow get: if isSignedIn() && isValidId(memberUid) &&
                   (request.auth.uid == memberUid || request.auth.uid == userId);
      allow list: if isTeamMember(userId) && resource.data.userId == userId;
      allow create: if isAdminForWorkspace(userId) &&
               request.auth.uid == incoming().assignedByUid &&
               incoming().memberUid == memberUid &&
               isValidId(memberUid) &&
               isValidRoleAssignment(incoming(), userId) &&
               hasRoleChangeAudit(incoming(), userId);
      allow update: if isAdminForWorkspace(userId) && isValidId(memberUid) && isValidRoleAssignment(incoming(), userId) &&
               request.auth.uid == incoming().assignedByUid &&
               incoming().memberUid == existing().memberUid &&
               incoming().userId == existing().userId &&
               incoming().createdAt == existing().createdAt &&
               incoming().auditLogId != existing().auditLogId &&
               (existing().get('isInitialOwner', false) == false ||
                (incoming().role in ['Owner', 'Admin'] && incoming().get('accountStatus', 'Active') == 'Active')) &&
               hasRoleChangeAudit(incoming(), userId);
      allow delete: if isInitialOwnerForWorkspace(userId) && isValidId(memberUid) &&
                       resource.data.get('isInitialOwner', false) == false;
    }

    match /users/{userId}/clients/{clientId} {
      allow get, list: if isTeamMember(userId);
      allow create, update: if isAdminForWorkspace(userId) && isValidId(clientId) &&
                               incoming().userId == userId && incoming().clientId == clientId;
      allow delete: if isAdminForWorkspace(userId) && isValidId(clientId);
    }

    match /users/{userId}/fiscal_years/{fiscalYearId} {
      allow get, list: if isTeamMember(userId);
      allow create, update, delete: if isAdminForWorkspace(userId) && isValidId(fiscalYearId);
    }

    match /users/{userId}/client_assignments/{assignmentId} {
      allow get, list: if isTeamMember(userId) || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      allow create, update, delete: if isAdminForWorkspace(userId) && isValidId(assignmentId);
    }

    match /users/{userId}/access_requests/{requestId} {
      allow get, list: if isTeamMember(userId) || (isSignedIn() && resource.data.requesterUid == request.auth.uid);
      allow create: if isSignedIn() && isNotDeletedIdentity(userId) && isValidId(requestId) &&
                       incoming().requesterUid == request.auth.uid && incoming().status == 'Pending';
      allow update: if isAdminForWorkspace(userId) && isValidId(requestId);
      allow delete: if isAdminForWorkspace(userId) && isValidId(requestId);
    }

    match /users/{userId}/master_workbook_state/{stateId} {
      allow get, list: if isTeamMember(userId);
      allow create, update: if (isAdminForWorkspace(userId) || canPublishAndSync(userId)) && isValidId(stateId);
      allow delete: if isAdminForWorkspace(userId) && isValidId(stateId);
    }

    match /users/{userId}/master_sync_jobs/{jobId} {
      allow get, list: if isTeamMember(userId);
      allow create, update: if (isAdminForWorkspace(userId) || canPublishAndSync(userId)) && isValidId(jobId);
      allow delete: if isAdminForWorkspace(userId) && isValidId(jobId);
    }

    match /users/{userId}/deletion_jobs/{jobId} {
      allow get, list: if isAdminForWorkspace(userId);
      allow create, update, delete: if isAdminForWorkspace(userId) && isValidId(jobId);
    }

    match /users/{userId}/deleted_identities/{deletedUid} {
      allow get: if isSignedIn() && (request.auth.uid == deletedUid || request.auth.uid == userId);
      allow list: if isAdminForWorkspace(userId);
      allow create, update: if isAdminForWorkspace(userId) && isValidId(deletedUid);
      allow delete: if false;
    }

    match /users/{userId}/deletion_audit_events/{eventId} {
      allow get, list: if isAdminForWorkspace(userId);
      allow create: if isAdminForWorkspace(userId) && isValidId(eventId);
      allow update, delete: if false;
    }

    match /users/{userId}/migration_backups/{backupId} {
      allow get, list, create, update, delete: if isAdminForWorkspace(userId) && isValidId(backupId);
    }

    match /users/{userId}/far_assets/{assetKey} {
      allow get: if canAccessClientScope(userId, resource.data) && isValidId(assetKey);
      allow list: if isTeamMember(userId) && resource.data.userId == userId;
      allow create: if isAdminForWorkspace(userId) && isValidId(assetKey) && isValidFARAsset(incoming(), userId);
      allow update: if isAdminForWorkspace(userId) && isValidFARAsset(incoming(), userId) &&
                       isValidId(assetKey) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().assetId == existing().assetId &&
                       incoming().sourceRow == existing().sourceRow &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'importBatchId', 'clientId', 'fiscalYearId', 'department', 'location',
                         'matchingKeyValue', 'sourceWorkbookName', 'sourceWorksheetName',
                         'rawRowByHeaderJson', 'mappedValuesByFieldIdJson', 'updatedAt'
                       ]);
      allow delete: if isAdminForWorkspace(userId) && isValidId(assetKey);
    }

    match /users/{userId}/counting_records/{assetKey} {
      allow get: if canAccessClientScope(userId, resource.data) && isValidId(assetKey);
      allow list: if isTeamMember(userId) && resource.data.userId == userId;
      allow create: if canAccessClientScope(userId, incoming()) && isValidId(assetKey) && isValidCountingRecord(incoming(), userId) &&
               (canReviewWorkspace(userId) || !hasReviewerMetadata(incoming()));
      allow update: if canAccessClientScope(userId, incoming()) && isValidCountingRecord(incoming(), userId) &&
                       isValidId(assetKey) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().assetKey == existing().assetKey &&
                       incoming().assetId == existing().assetId &&
                       incoming().sourceRow == existing().sourceRow &&
                       (reviewerMetadataUnchanged(incoming(), existing()) || canReviewWorkspace(userId)) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'found', 'countDate', 'countedBy', 'countedByUserId',
                         'buildingSite', 'buildingSiteOther',
                         'floor', 'floorOther', 'roomLocation', 'roomLocationOther',
                         'department', 'departmentOther', 'userCustodian', 'tagStatus',
                         'tagNumberAcn', 'brandModel', 'physicalQtyText', 'condition',
                         'inUse', 'photoRef', 'remarks', 'qtyDiffText', 'result',
                         'countingStatus', 'applicableExceptions',
                         'reviewedBy', 'reviewedByUserId', 'reviewerRequiredFlag',
                         'reviewedAt', 'reviewStatus', 'clientExplanation', 'isDraft',
                         'auditTrailSummary', 'clientId', 'fiscalYearId', 'dynamicFieldValuesJson',
                         'updatedAt'
                       ]);
      allow delete: if isAdminForWorkspace(userId) && isValidId(assetKey);
    }

    match /users/{userId}/master_data/{configId} {
      allow get: if isTeamMember(userId) && isValidId(configId);
      allow list: if isTeamMember(userId) && resource.data.userId == userId;
      allow create: if isAdminForWorkspace(userId) && isValidId(configId) && isValidMasterDataConfig(incoming(), userId);
      allow update: if isAdminForWorkspace(userId) && isValidMasterDataConfig(incoming(), userId) &&
                       isValidId(configId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'auditors', 'sites', 'floors', 'rooms', 'departments',
                         'clientId', 'fiscalYearId', 'updatedAt'
                       ]);
      allow delete: if isAdminForWorkspace(userId) && isValidId(configId);
    }

    match /users/{userId}/exceptions/{exceptionId} {
      allow get: if isTeamMember(userId) && isValidId(exceptionId);
      allow list: if isTeamMember(userId) && resource.data.userId == userId;
      allow create: if isTeamMember(userId) && isValidId(exceptionId) && isValidExceptionRecord(incoming(), userId);
      allow update: if isTeamMember(userId) && isValidExceptionRecord(incoming(), userId) &&
                       isValidId(exceptionId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().assetKey == existing().assetKey &&
                       incoming().assetId == existing().assetId &&
                       incoming().sourceRow == existing().sourceRow &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'exceptionType', 'description', 'status', 'followUpNotes',
                         'resolutionHistory', 'clientId', 'fiscalYearId', 'updatedAt'
                       ]);
      allow delete: if isAdminForWorkspace(userId) && isValidId(exceptionId);
    }

    match /users/{userId}/found_not_in_far/{recordId} {
      allow get: if isTeamMember(userId) && isValidId(recordId);
      allow list: if isTeamMember(userId) && resource.data.userId == userId;
      allow create: if isTeamMember(userId) && isValidId(recordId) && isValidFoundNotInFarRecord(incoming(), userId) &&
                       (canReviewWorkspace(userId) ||
                        (incoming().reviewedBy == '' && incoming().reviewedByUserId == '' && incoming().reviewedAt == ''));
      allow update: if isTeamMember(userId) && isValidFoundNotInFarRecord(incoming(), userId) &&
                       isValidId(recordId) &&
                       incoming().userId == existing().userId &&
                       incoming().tempId == existing().tempId &&
                       ((incoming().reviewedBy == existing().reviewedBy &&
                         incoming().reviewedByUserId == existing().reviewedByUserId &&
                         incoming().reviewedAt == existing().reviewedAt) || canReviewWorkspace(userId));
      allow delete: if isAdminForWorkspace(userId) && isValidId(recordId);
    }

    match /users/{userId}/asset_photos/{photoId} {
      allow get: if isTeamMember(userId) && isValidId(photoId);
      allow list: if isTeamMember(userId) && resource.data.userId == userId;
      allow create: if isTeamMember(userId) && isValidId(photoId) && isValidAssetPhotoRecord(incoming(), userId);
      allow update: if isTeamMember(userId) && isValidAssetPhotoRecord(incoming(), userId) &&
                       isValidId(photoId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdminForWorkspace(userId) && isValidId(photoId);
    }

    match /users/{userId}/project_settings/{settingId} {
      allow get: if isTeamMember(userId) && isValidId(settingId);
      allow list: if isTeamMember(userId) && resource.data.userId == userId;
      allow create: if isAdminForWorkspace(userId) && isValidId(settingId) && isValidProjectSettings(incoming(), userId);
      allow update: if (
                       isAdminForWorkspace(userId) ||
                       (canSyncDrive(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
                         'connectedDriveEmail', 'rootDriveFolderId', 'photosDriveFolderId',
                         'reportsDriveFolderId', 'backupsDriveFolderId',
                         'driveConnectionStatus', 'updatedAt'
                       ])) ||
                       (canPublishAndSync(userId) &&
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'masterWorkbookDriveFileId', 'masterWorkbookVersion',
                          'lastMasterUpdateAtIso', 'lastMasterUpdateStatus',
                          'lastMasterUpdateError', 'planRevisionHistory', 'updatedAt'
                        ]) &&
                        (
                          (
                            incoming().masterWorkbookVersion == existing().masterWorkbookVersion + 1 &&
                            incoming().masterWorkbookDriveFileId.size() > 0 &&
                            incoming().lastMasterUpdateAtIso.size() > 0 &&
                            incoming().lastMasterUpdateError == ''
                          ) ||
                          (
                            incoming().masterWorkbookVersion == existing().masterWorkbookVersion &&
                            incoming().masterWorkbookDriveFileId == existing().masterWorkbookDriveFileId &&
                            incoming().lastMasterUpdateStatus.matches('^Failed.*') &&
                            incoming().lastMasterUpdateError.size() > 0
                          )
                        ))
                     ) && isValidProjectSettings(incoming(), userId) &&
                       isValidId(settingId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdminForWorkspace(userId) && isValidId(settingId);
    }

    match /users/{userId}/counting_plan_stages/{stageId} {
      allow get: if isTeamMember(userId) && isValidId(stageId);
      allow list: if isTeamMember(userId) && resource.data.userId == userId;
      allow create: if isAdminForWorkspace(userId) && isValidId(stageId) && isValidCountingPlanStage(incoming(), userId);
      allow update: if isAdminForWorkspace(userId) && isValidCountingPlanStage(incoming(), userId) &&
                       isValidId(stageId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdminForWorkspace(userId) && isValidId(stageId);
    }

    match /users/{userId}/activity_logs/{logId} {
      allow get: if isTeamMember(userId) && isValidId(logId);
      allow list: if isTeamMember(userId) && resource.data.userId == userId;
      allow create: if isTeamMember(userId);
      allow update: if false; // Activity logs are append-only
      allow delete: if isAdminForWorkspace(userId) && isValidId(logId);
    }

    match /users/{userId}/export_jobs/{jobId} {
      allow get: if isTeamMember(userId) && isValidId(jobId);
      allow list: if isTeamMember(userId) && resource.data.userId == userId;
      allow create: if isAdminForWorkspace(userId) && isValidId(jobId) && isValidExportJobRecord(incoming(), userId);
      allow update: if isAdminForWorkspace(userId) && isValidExportJobRecord(incoming(), userId) &&
                       isValidId(jobId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdminForWorkspace(userId) && isValidId(jobId);
    }

    match /users/{userId}/schema_versions/{versionId} {
      allow get: if isTeamMember(userId) && isValidId(versionId);
      allow list: if isTeamMember(userId) && resource.data.userId == userId;
      allow create: if isAdminForWorkspace(userId) && isValidId(versionId) && isValidWorkbookSchemaVersion(incoming(), userId);
      allow update: if isAdminForWorkspace(userId) && isValidId(versionId) && isValidWorkbookSchemaVersion(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdminForWorkspace(userId) && isValidId(versionId);
    }

    match /users/{userId}/submissions/{submissionId} {
      allow get: if isSignedIn() && isValidId(submissionId) && (
        request.auth.uid == userId ||
        canReviewWorkspace(resource.data.workspaceId)
      );
      allow list: if isSignedIn() && (
        (request.auth.uid == userId && resource.data.userId == request.auth.uid) ||
        canReviewWorkspace(resource.data.workspaceId)
      );
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(submissionId) &&
                       isValidUserSubmissionRecord(incoming(), userId) &&
                       incoming().submitterUid == request.auth.uid &&
                       incoming().submissionStatus in ['Draft', 'Pending Review'] &&
                       incoming().reviewedByUid == '' &&
                       incoming().publishedWorkbookVersion == 0 &&
                       incoming().publishedAtIso == '' &&
                       incoming().publishedAuditLogId == '';
      allow update: if isSignedIn() &&
                       isValidId(submissionId) &&
                       isValidUserSubmissionRecord(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().submitterUid == existing().submitterUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           request.auth.uid == userId &&
                           existing().submissionStatus in ['Draft', 'Pending Review', 'Changes Requested'] &&
                           incoming().submissionStatus in ['Draft', 'Pending Review', 'Changes Requested'] &&
                           incoming().workspaceId == existing().workspaceId &&
                           incoming().assetKey == existing().assetKey &&
                           incoming().assetId == existing().assetId &&
                           incoming().sourceRow == existing().sourceRow &&
                           incoming().reviewedByUid == existing().reviewedByUid &&
                           incoming().reviewedByName == existing().reviewedByName &&
                           incoming().reviewedAtIso == existing().reviewedAtIso &&
                           incoming().publishedWorkbookVersion == existing().publishedWorkbookVersion &&
                           incoming().publishedAtIso == existing().publishedAtIso &&
                           incoming().publishedByUid == existing().publishedByUid &&
                           incoming().publishedByName == existing().publishedByName &&
                           incoming().publishedAuditLogId == existing().publishedAuditLogId
                         ) ||
                         (
                           canReviewWorkspace(existing().workspaceId) &&
                           existing().submissionStatus in ['Pending Review', 'Changes Requested', 'Sync Failed'] &&
                           incoming().submissionStatus in ['Approved — Awaiting Master Update', 'Changes Requested', 'Rejected'] &&
                           submissionContentUnchanged(incoming(), existing()) &&
                           incoming().reviewedByUid == request.auth.uid &&
                           incoming().reviewedByName.size() > 0 &&
                           incoming().reviewedAtIso.size() > 0 &&
                           incoming().publishedWorkbookVersion == existing().publishedWorkbookVersion &&
                           incoming().publishedAtIso == existing().publishedAtIso &&
                           incoming().publishedByUid == existing().publishedByUid &&
                           incoming().publishedByName == existing().publishedByName &&
                           incoming().publishedAuditLogId == existing().publishedAuditLogId
                         ) ||
                         (
                           canPublishToMaster(existing().workspaceId) &&
                           submissionContentUnchanged(incoming(), existing()) &&
                           existing().submissionStatus in ['Approved — Awaiting Master Update', 'Sync Failed'] &&
                           incoming().submissionStatus == 'Master Update In Progress' &&
                           incoming().reviewedByUid == existing().reviewedByUid &&
                           incoming().reviewedByName == existing().reviewedByName &&
                           incoming().reviewedAtIso == existing().reviewedAtIso &&
                           incoming().publishedWorkbookVersion == existing().publishedWorkbookVersion &&
                           incoming().publishedAtIso == existing().publishedAtIso &&
                           incoming().publishedByUid == existing().publishedByUid &&
                           incoming().publishedByName == existing().publishedByName &&
                           incoming().publishedAuditLogId == existing().publishedAuditLogId
                         ) ||
                         (
                           canPublishToMaster(existing().workspaceId) &&
                           submissionContentUnchanged(incoming(), existing()) &&
                           existing().submissionStatus == 'Master Update In Progress' &&
                           incoming().submissionStatus == 'Sync Failed' &&
                           incoming().reviewedByUid == existing().reviewedByUid &&
                           incoming().reviewedByName == existing().reviewedByName &&
                           incoming().reviewedAtIso == existing().reviewedAtIso &&
                           incoming().publishedWorkbookVersion == existing().publishedWorkbookVersion &&
                           incoming().publishedAtIso == existing().publishedAtIso &&
                           incoming().publishedAuditLogId == existing().publishedAuditLogId
                         ) ||
                         (
                           canPublishToMaster(existing().workspaceId) &&
                           submissionContentUnchanged(incoming(), existing()) &&
                           existing().submissionStatus == 'Master Update In Progress' &&
                           incoming().submissionStatus == 'Published' &&
                           incoming().publishedWorkbookVersion > existing().publishedWorkbookVersion &&
                           incoming().publishedWorkbookVersion == get(/databases/$(database)/documents/users/$(existing().workspaceId)/project_settings/main).data.masterWorkbookVersion &&
                           incoming().publishedByUid == request.auth.uid &&
                           incoming().publishedByName.size() > 0 &&
                           incoming().publishedAtIso.size() > 0 &&
                           submissionPublicationAuditMatches(incoming(), existing().workspaceId)
                         )
                       );
      allow delete: if isAdminForWorkspace(resource.data.workspaceId) && isValidId(submissionId);
    }

    match /users/{userId}/daily_batches/{batchId} {
      allow get: if isTeamMember(userId) && isValidId(batchId);
      allow list: if isTeamMember(userId);
      allow create: if isSignedIn() && isTeamMember(userId) && request.auth.uid == incoming().submitterUid &&
                       incoming().status in ['Draft / In Progress', 'Submitted / Pending Review'] &&
                       incoming().reviewedByUid == '' && incoming().publishedByUid == '' &&
                       incoming().publishedMasterVersion == 0 && incoming().publicationAuditLogId == '' &&
                       isValidId(batchId) && isValidDailyBatchSubmission(incoming(), userId);
      allow update: if isSignedIn() && isValidId(batchId) &&
                       (
                         (dailyBatchSubmitterEdit(incoming(), existing()) && isValidDailyBatchSubmission(incoming(), userId)) ||
                         (dailyBatchReviewTransition(incoming(), existing(), userId) && isValidDailyBatchSubmission(incoming(), userId)) ||
                         (dailyBatchPublishFailure(incoming(), existing(), userId) && isValidDailyBatchSubmission(incoming(), userId)) ||
                         dailyBatchPublishSuccess(incoming(), existing(), userId) ||
                         (isAdminForWorkspace(userId) && isValidDailyBatchSubmission(incoming(), userId))
                       );
      allow delete: if isAdminForWorkspace(userId) && isValidId(batchId);
    }

    match /users/{userId}/daily_batches/{batchId}/version_chunks/{chunkId} {
      allow get, list: if isTeamMember(userId);
      allow create, update: if isTeamMember(userId) && isValidId(chunkId);
      allow delete: if isAdminForWorkspace(userId) && isValidId(chunkId);
    }

    match /users/{userId}/review_requests/{requestId} {
      allow get: if isTeamMember(userId) && isValidId(requestId);
      allow list: if isTeamMember(userId);
      allow create: if isSignedIn() && isTeamMember(userId) &&
                       incoming().userId == request.auth.uid && isValidId(requestId);
      allow update: if canReviewWorkspace(userId) && isValidId(requestId) &&
                       incoming().userId == existing().userId &&
                       incoming().batchId == existing().batchId &&
                       incoming().requestedAtIso == existing().requestedAtIso &&
                       incoming().reviewedByUid == request.auth.uid &&
                       incoming().reviewedByName is string && incoming().reviewedByName.size() > 0 &&
                       incoming().requestStatus in ['Under Review', 'Reviewed', 'Closed'];
      allow delete: if isAdminForWorkspace(userId) && isValidId(requestId);
    }

    match /users/{userId}/notifications/{notificationId} {
      allow list: if isTeamMember(userId);
      allow get: if isTeamMember(userId) && isValidId(notificationId);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(userId)/notifications/$(notificationId)) &&
         get(/databases/$(database)/documents/users/$(userId)/notifications/$(notificationId)).data.userId == request.auth.uid) ||
        isAdminForWorkspace(userId)
      );
    }

    match /users/{userId}/column_mapping/{mappingId} {
      allow get, list: if isTeamMember(userId) && isValidId(mappingId);
      allow create, update: if isAdminForWorkspace(userId) && isValidId(mappingId);
      allow delete: if isAdminForWorkspace(userId) && isValidId(mappingId);
    }
  }
}
