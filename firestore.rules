        data.assetKey == oldData.assetKey &&
        data.assetId == oldData.assetId &&
        data.sourceRow == oldData.sourceRow &&
        data.schemaVersionId == oldData.schemaVersionId &&
        data.schemaVersionNumber == oldData.schemaVersionNumber &&
        data.fieldValuesJson == oldData.fieldValuesJson &&
        data.fixedFieldSnapshotJson == oldData.fixedFieldSnapshotJson &&
        data.photoIdsCsv == oldData.photoIdsCsv;
    }

