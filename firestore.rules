rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNotDeletedIdentity(workspaceId) {
      return !exists(/databases/$(database)/documents/users/$(workspaceId)/deleted_identities/$(request.auth.uid));
    }

    // Team membership check: workspace owner OR explicitly registered in workspace's role_assignments
    function isTeamMember(workspaceId) {
      let rolePath = /databases/$(database)/documents/users/$(workspaceId)/role_assignments/$(request.auth.uid);
      return isSignedIn() && isNotDeletedIdentity(workspaceId) && (
        request.auth.uid == workspaceId ||
        (exists(rolePath) &&
         get(rolePath).data.userId == workspaceId &&
         get(rolePath).data.memberUid == request.auth.uid &&
         (!('accountStatus' in get(rolePath).data) || get(rolePath).data.accountStatus == 'Active'))
      );
    }

    function isInitialOwnerForWorkspace(workspaceId) {
      let ownPath = /databases/$(database)/documents/users/$(workspaceId)/system_config/ownership;
      let rolePath = /databases/$(database)/documents/users/$(workspaceId)/role_assignments/$(request.auth.uid);
      return isSignedIn() && isNotDeletedIdentity(workspaceId) && (
        (request.auth.uid == workspaceId && !exists(rolePath)) ||
        (exists(ownPath) && get(ownPath).data.ownerUid == request.auth.uid) ||
        (exists(rolePath) && (('isInitialOwner' in get(rolePath).data) && get(rolePath).data.isInitialOwner == true)) ||
        (exists(rolePath) && get(rolePath).data.role == 'Owner')
      );
    }

    // Privileges are scoped to this workspace. Global token claims and email addresses
    // must not grant access to unrelated workspaces.
    function isAdminForWorkspace(workspaceId) {
      let rolePath = /databases/$(database)/documents/users/$(workspaceId)/role_assignments/$(request.auth.uid);
      return isSignedIn() && isNotDeletedIdentity(workspaceId) && (
        (request.auth.uid == workspaceId && !exists(rolePath)) ||
        (exists(rolePath) &&
         get(rolePath).data.userId == workspaceId &&
         get(rolePath).data.memberUid == request.auth.uid &&
         get(rolePath).data.role in ['Admin', 'Owner'] &&
         (!('accountStatus' in get(rolePath).data) || get(rolePath).data.accountStatus == 'Active'))
      );
    }

    function canReviewWorkspace(workspaceId) {
      let rolePath = /databases/$(database)/documents/users/$(workspaceId)/role_assignments/$(request.auth.uid);
      return isSignedIn() && isNotDeletedIdentity(workspaceId) && (
        (request.auth.uid == workspaceId && !exists(rolePath)) ||
        (exists(rolePath) &&
         get(rolePath).data.userId == workspaceId &&
         (!('accountStatus' in get(rolePath).data) || get(rolePath).data.accountStatus == 'Active') &&
         (get(rolePath).data.role in ['Admin', 'Owner', 'Reviewer'] ||
          (('hasReviewAuthority' in get(rolePath).data) && get(rolePath).data.hasReviewAuthority == true)))
      );
    }

    function canPublishToMaster(workspaceId) {
      let rolePath = /databases/$(database)/documents/users/$(workspaceId)/role_assignments/$(request.auth.uid);
      return isSignedIn() && isNotDeletedIdentity(workspaceId) && (
        (request.auth.uid == workspaceId && !exists(rolePath)) ||
        (exists(rolePath) &&
         get(rolePath).data.userId == workspaceId &&
         (!('accountStatus' in get(rolePath).data) || get(rolePath).data.accountStatus == 'Active') &&
         (get(rolePath).data.role in ['Admin', 'Owner'] ||
          (('canPublish' in get(rolePath).data) && get(rolePath).data.canPublish == true)))
      );
    }

    function canSyncDrive(workspaceId) {
      let rolePath = /databases/$(database)/documents/users/$(workspaceId)/role_assignments/$(request.auth.uid);
      return isSignedIn() && isNotDeletedIdentity(workspaceId) && (
        (request.auth.uid == workspaceId && !exists(rolePath)) ||
        (exists(rolePath) &&
         get(rolePath).data.userId == workspaceId &&
         (!('accountStatus' in get(rolePath).data) || get(rolePath).data.accountStatus == 'Active') &&
         (get(rolePath).data.role in ['Admin', 'Owner'] ||
          (('canSyncDrive' in get(rolePath).data) && get(rolePath).data.canSyncDrive == true)))
      );
    }

    function canPublishAndSync(workspaceId) {
      let rolePath = /databases/$(database)/documents/users/$(workspaceId)/role_assignments/$(request.auth.uid);
      return isSignedIn() && isNotDeletedIdentity(workspaceId) && (
        (request.auth.uid == workspaceId && !exists(rolePath)) ||
        (exists(rolePath) &&
         get(rolePath).data.userId == workspaceId &&
         (!('accountStatus' in get(rolePath).data) || get(rolePath).data.accountStatus == 'Active') &&
         (get(rolePath).data.role in ['Admin', 'Owner'] ||
          ((('canPublish' in get(rolePath).data) && get(rolePath).data.canPublish == true) &&
           (('canSyncDrive' in get(rolePath).data) && get(rolePath).data.canSyncDrive == true))))
      );
    }

    // Client assignment check for multi-client scoped documents:
    // If clientId is blank (legacy records), falls back to isTeamMember(workspaceId).
    // If clientId is non-blank, allows Admin/Reviewer or an Auditor whose client_assignments/{clientId}_{uid} is Assigned
    // (or if no client_assignments doc exists for that clientId_uid in legacy unit tests, falls back to isTeamMember).
    function canAccessClientScope(workspaceId, data) {
      let cid = data.get('clientId', '');
      let assignPath = /databases/$(database)/documents/users/$(workspaceId)/client_assignments/$(cid + '_' + request.auth.uid);
      return isTeamMember(workspaceId) && (
        cid == '' ||
        isAdminForWorkspace(workspaceId) ||
        canReviewWorkspace(workspaceId) ||
        !exists(assignPath) ||
        get(assignPath).data.get('assignedStatus', 'Assigned') == 'Assigned'
      );
    }

    function isValidUserProfile(data, workspaceId) {
      return data.keys().hasAll([
        'displayName', 'email', 'role', 'userId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'displayName', 'fullName', 'nickname', 'email', 'role', 'accountStatus',
        'hasReviewAuthority', 'canPublish', 'userId', 'createdAt', 'updatedAt'
      ]) &&
      data.displayName is string && data.displayName.size() <= 150 &&
      (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 150)) &&
      (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 40)) &&
      (!('accountStatus' in data) || (data.accountStatus is string && data.accountStatus in ['Active', 'Deactivated', 'Deleted'])) &&
      (!('hasReviewAuthority' in data) || data.hasReviewAuthority is bool) &&
      (!('canPublish' in data) || data.canPublish is bool) &&
      data.email is string && data.email.size() <= 200 &&
      data.role is string && data.role in ['Owner', 'Auditor', 'Reviewer', 'Admin', 'EndUser', 'PendingAdmin'] &&
      (!(data.role in ['Admin', 'Owner']) || isAdminForWorkspace(workspaceId)) &&
      data.userId is string && data.userId == workspaceId &&
      data.createdAt is timestamp && data.createdAt <= request.time &&
      data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSelfUserProfile(data, workspaceId) {
      return isValidUserProfile(data, workspaceId) &&
        data.role in ['Auditor', 'EndUser', 'PendingAdmin'] &&
        (!('hasReviewAuthority' in data) || data.hasReviewAuthority == false) &&
        (!('canPublish' in data) || data.canPublish == false);
    }

    function isValidSelfUserProfileUpdate(data, oldData, workspaceId) {
      return isValidUserProfile(data, workspaceId) &&
        data.role == oldData.role &&
        data.get('hasReviewAuthority', false) == oldData.get('hasReviewAuthority', false) &&
        data.get('canPublish', false) == oldData.get('canPublish', false);
    }

    function isValidRoleAssignment(data, workspaceId) {
      return data.keys().hasAll([
        'memberUid', 'email', 'displayName', 'role',
        'auditLogId',
        'assignedByUid', 'assignedByName', 'lastActiveAtIso',
        'userId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'memberUid', 'email', 'displayName', 'fullName', 'nickname', 'role',
        'isInitialOwner', 'accountStatus',
        'hasReviewAuthority', 'canPublish', 'canSyncDrive',
        'canManageUsersAndRoles', 'canDeleteClientsAndUsers',
        'auditLogId',
        'assignedByUid', 'assignedByName', 'lastActiveAtIso',
        'userId', 'createdAt', 'updatedAt'
      ]) &&
      data.memberUid is string && data.memberUid.size() >= 1 && data.memberUid.size() <= 128 &&
      data.email is string && data.email.size() <= 200 &&
      data.displayName is string && data.displayName.size() <= 150 &&
      (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 150)) &&
      (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 40)) &&
      (!('isInitialOwner' in data) || data.isInitialOwner is bool) &&
      (!('accountStatus' in data) || (data.accountStatus is string && data.accountStatus in ['Active', 'Deactivated'])) &&
      (!('hasReviewAuthority' in data) || data.hasReviewAuthority is bool) &&
      (!('canPublish' in data) || data.canPublish is bool) &&
      (!('canSyncDrive' in data) || data.canSyncDrive is bool) &&
      (!('canManageUsersAndRoles' in data) || data.canManageUsersAndRoles is bool) &&
      (!('canDeleteClientsAndUsers' in data) || data.canDeleteClientsAndUsers is bool) &&
      data.auditLogId is string && data.auditLogId.size() >= 1 && data.auditLogId.size() <= 128 &&
      data.role is string && data.role in ['Owner', 'Auditor', 'Reviewer', 'Admin', 'EndUser', 'PendingAdmin'] &&
      data.assignedByUid is string && data.assignedByUid.size() <= 128 &&
      data.assignedByName is string && data.assignedByName.size() <= 150 &&
      data.lastActiveAtIso is string && data.lastActiveAtIso.size() <= 60 &&
      data.userId is string && data.userId == workspaceId &&
      data.createdAt is timestamp && data.createdAt <= request.time &&
      data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFARAsset(data, workspaceId) {
      return data.keys().hasAll([
        'sl', 'assetId', 'sourceRow', 'assetDescription', 'assetClass',
        'capitalizedOn', 'costTk', 'nbvTk', 'farQty', 'farQtyPresent',
        'method', 'sheetOrigin', 'importBatchId', 'userId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'sl', 'assetId', 'sourceRow', 'assetDescription', 'assetClass',
        'capitalizedOn', 'costTk', 'nbvTk', 'farQty', 'farQtyPresent',
        'method', 'sheetOrigin', 'importBatchId',
        'clientId', 'fiscalYearId', 'department', 'location', 'matchingKeyValue',
        'sourceWorkbookName', 'sourceWorksheetName', 'rawRowByHeaderJson', 'mappedValuesByFieldIdJson',
        'userId', 'createdAt', 'updatedAt'
      ]) &&
      data.sl is int && data.sl >= 0 &&
      data.assetId is string && data.assetId.size() >= 1 && data.assetId.size() <= 100 &&
      data.sourceRow is int && data.sourceRow >= 1 &&
      data.assetDescription is string && data.assetDescription.size() <= 500 &&
      data.assetClass is string && data.assetClass.size() <= 150 &&
      data.capitalizedOn is string && data.capitalizedOn.size() <= 50 &&
      data.costTk is number &&
      data.nbvTk is number &&
      data.farQty is int && data.farQty >= 0 &&
      data.farQtyPresent is bool &&
      data.method is string && data.method.size() <= 100 &&
      data.sheetOrigin is string && data.sheetOrigin.size() <= 100 &&
      data.importBatchId is string && data.importBatchId.size() <= 100 &&
      (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
      (!('fiscalYearId' in data) || (data.fiscalYearId is string && data.fiscalYearId.size() <= 60)) &&
      (!('department' in data) || (data.department is string && data.department.size() <= 200)) &&
      (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
      (!('matchingKeyValue' in data) || (data.matchingKeyValue is string && data.matchingKeyValue.size() <= 128)) &&
      (!('sourceWorkbookName' in data) || (data.sourceWorkbookName is string && data.sourceWorkbookName.size() <= 256)) &&
      (!('sourceWorksheetName' in data) || (data.sourceWorksheetName is string && data.sourceWorksheetName.size() <= 128)) &&
      (!('rawRowByHeaderJson' in data) || (data.rawRowByHeaderJson is string && data.rawRowByHeaderJson.size() <= 50000)) &&
      (!('mappedValuesByFieldIdJson' in data) || (data.mappedValuesByFieldIdJson is string && data.mappedValuesByFieldIdJson.size() <= 50000)) &&
      data.userId is string && data.userId == workspaceId &&
      data.createdAt is timestamp && data.createdAt <= request.time &&
      data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCountingRecord(data, workspaceId) {
      return data.keys().hasAll([
        'assetKey', 'assetId', 'sourceRow', 'found', 'countDate', 'countedBy',
        'countedByUserId', 'buildingSite', 'buildingSiteOther',
        'floor', 'floorOther', 'roomLocation', 'roomLocationOther',
        'department', 'departmentOther', 'userCustodian',
        'tagStatus', 'tagNumberAcn', 'brandModel', 'physicalQtyText',
        'condition', 'inUse', 'photoRef', 'remarks', 'qtyDiffText',
        'result', 'countingStatus', 'applicableExceptions',
        'reviewedBy', 'reviewedByUserId', 'reviewerRequiredFlag',
        'reviewedAt', 'reviewStatus', 'clientExplanation',
        'isDraft', 'auditTrailSummary', 'userId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'assetKey', 'assetId', 'sourceRow', 'found', 'countDate', 'countedBy',
        'countedByUserId', 'buildingSite', 'buildingSiteOther',
        'floor', 'floorOther', 'roomLocation', 'roomLocationOther',
        'department', 'departmentOther', 'userCustodian',
        'tagStatus', 'tagNumberAcn', 'brandModel', 'physicalQtyText',
        'condition', 'inUse', 'photoRef', 'remarks', 'qtyDiffText',
        'result', 'countingStatus', 'applicableExceptions',
        'reviewedBy', 'reviewedByUserId', 'reviewerRequiredFlag',
        'reviewedAt', 'reviewStatus', 'clientExplanation',
        'isDraft', 'auditTrailSummary',
        'clientId', 'fiscalYearId', 'dynamicFieldValuesJson',
        'userId', 'createdAt', 'updatedAt'
      ]) &&
      data.assetKey is string && data.assetKey.size() >= 1 && data.assetKey.size() <= 128 &&
      data.assetId is string && data.assetId.size() >= 1 && data.assetId.size() <= 100 &&
      data.sourceRow is int && data.sourceRow >= 1 &&
      data.found is string && data.found.size() <= 50 &&
      data.countDate is string && data.countDate.size() <= 40 &&
      data.countedBy is string && data.countedBy.size() <= 150 &&
      data.countedByUserId is string && data.countedByUserId.size() <= 128 &&
      data.buildingSite is string && data.buildingSite.size() <= 150 &&
      data.buildingSiteOther is string && data.buildingSiteOther.size() <= 150 &&
      data.floor is string && data.floor.size() <= 100 &&
      data.floorOther is string && data.floorOther.size() <= 100 &&
      data.roomLocation is string && data.roomLocation.size() <= 150 &&
      data.roomLocationOther is string && data.roomLocationOther.size() <= 150 &&
      data.department is string && data.department.size() <= 150 &&
      data.departmentOther is string && data.departmentOther.size() <= 150 &&
      data.userCustodian is string && data.userCustodian.size() <= 150 &&
      data.tagStatus is string && data.tagStatus.size() <= 100 &&
      data.tagNumberAcn is string && data.tagNumberAcn.size() <= 100 &&
      data.brandModel is string && data.brandModel.size() <= 150 &&
      data.physicalQtyText is string && data.physicalQtyText.size() <= 30 &&
      data.condition is string && data.condition.size() <= 50 &&
      data.inUse is string && data.inUse.size() <= 30 &&
      data.photoRef is string && data.photoRef.size() <= 4000 &&
      data.remarks is string && data.remarks.size() <= 2000 &&
      data.qtyDiffText is string && data.qtyDiffText.size() <= 30 &&
      data.result is string && data.result.size() <= 80 &&
      data.countingStatus is string && data.countingStatus.size() <= 80 &&
      data.applicableExceptions is string && data.applicableExceptions.size() <= 1000 &&
      data.reviewedBy is string && data.reviewedBy.size() <= 150 &&
      data.reviewedByUserId is string && data.reviewedByUserId.size() <= 128 &&
      data.reviewerRequiredFlag is bool &&
      data.reviewedAt is string && data.reviewedAt.size() <= 60 &&
      data.reviewStatus is string && data.reviewStatus.size() <= 80 &&
      data.clientExplanation is string && data.clientExplanation.size() <= 2000 &&
      data.isDraft is bool &&
      data.auditTrailSummary is string && data.auditTrailSummary.size() <= 4000 &&
      (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
      (!('fiscalYearId' in data) || (data.fiscalYearId is string && data.fiscalYearId.size() <= 60)) &&
      (!('dynamicFieldValuesJson' in data) || (data.dynamicFieldValuesJson is string && data.dynamicFieldValuesJson.size() <= 50000)) &&
      data.userId is string && data.userId == workspaceId &&
      data.createdAt is timestamp && data.createdAt <= request.time &&
      data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function hasReviewerMetadata(data) {
      return data.reviewStatus == 'Reviewed' ||
        data.reviewedBy.size() > 0 ||
        data.reviewedByUserId.size() > 0 ||
        data.reviewedAt.size() > 0;
    }

    function reviewerMetadataUnchanged(data, oldData) {
      return data.reviewedBy == oldData.reviewedBy &&
        data.reviewedByUserId == oldData.reviewedByUserId &&
        data.reviewedAt == oldData.reviewedAt &&
        data.reviewStatus == oldData.reviewStatus;
    }

    function isValidDailyBatchSubmission(data, workspaceId) {
      return data.keys().hasAll([
        'batchId', 'userId', 'submitterUid', 'submitterFullName', 'submitterNickname',
        'countingDate', 'versionNumber', 'recordCount', 'foundCount', 'notFoundCount',
        'notAccessibleCount', 'manualEntryCount', 'status', 'recordsJson', 'adminRemarks',
        'remarksByUid', 'remarksByName', 'remarksAtIso', 'reviewedByUid', 'reviewedByName',
        'reviewedAtIso', 'publishedByUid', 'publishedByName', 'publishedAtIso',
        'publishedMasterFileId', 'publishedMasterVersion', 'publicationAuditLogId',
        'historyVersionsJson', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'batchId', 'userId', 'submitterUid', 'submitterFullName', 'submitterNickname',
        'clientId', 'fiscalYearId',
        'countingDate', 'versionNumber', 'recordCount', 'foundCount', 'notFoundCount',
        'notAccessibleCount', 'manualEntryCount', 'status',
        'approvalStatus', 'masterSyncStatus', 'masterSyncJobId', 'masterSyncError',
        'dailySheetDriveFileId', 'isChunkedSnapshot', 'chunkCount',
        'recordsJson', 'adminRemarks',
        'remarksByUid', 'remarksByName', 'remarksAtIso', 'reviewedByUid', 'reviewedByName',
        'reviewedAtIso', 'publishedByUid', 'publishedByName', 'publishedAtIso',
        'publishedMasterFileId', 'publishedMasterVersion', 'publicationAuditLogId',
        'historyVersionsJson', 'createdAt', 'updatedAt'
      ]) &&
      data.batchId is string && data.batchId.size() >= 1 && data.batchId.size() <= 128 &&
      data.userId == workspaceId &&
      data.submitterUid is string && data.submitterUid.size() >= 1 && data.submitterUid.size() <= 128 &&
      data.submitterFullName is string && data.submitterFullName.size() <= 150 &&
      data.submitterNickname is string && data.submitterNickname.size() <= 60 &&
      (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
      (!('fiscalYearId' in data) || (data.fiscalYearId is string && data.fiscalYearId.size() <= 60)) &&
      data.countingDate is string && data.countingDate.size() <= 40 &&
      data.versionNumber is int && data.versionNumber >= 1 &&
      data.recordCount is int && data.recordCount >= 0 &&
      data.foundCount is int && data.foundCount >= 0 &&
      data.notFoundCount is int && data.notFoundCount >= 0 &&
      data.notAccessibleCount is int && data.notAccessibleCount >= 0 &&
      data.manualEntryCount is int && data.manualEntryCount >= 0 &&
      data.status is string && data.status in [
        'Draft / In Progress', 'Submitted / Pending Review', 'Under Review',
        'Changes Requested', 'Corrected / Resubmitted', 'Approved — Awaiting Master Update',
        'Published', 'Rejected', 'Sync Failed'
      ] &&
      (!('approvalStatus' in data) || (data.approvalStatus is string && data.approvalStatus.size() <= 60)) &&
      (!('masterSyncStatus' in data) || (data.masterSyncStatus is string && data.masterSyncStatus.size() <= 60)) &&
      (!('masterSyncJobId' in data) || (data.masterSyncJobId is string && data.masterSyncJobId.size() <= 128)) &&
      (!('masterSyncError' in data) || (data.masterSyncError is string && data.masterSyncError.size() <= 2000)) &&
      (!('dailySheetDriveFileId' in data) || (data.dailySheetDriveFileId is string && data.dailySheetDriveFileId.size() <= 256)) &&
      (!('isChunkedSnapshot' in data) || data.isChunkedSnapshot is bool) &&
      (!('chunkCount' in data) || (data.chunkCount is int && data.chunkCount >= 0)) &&
      data.recordsJson is string && data.recordsJson.size() <= 100000 &&
      data.adminRemarks is string && data.adminRemarks.size() <= 2000 &&
      data.remarksByUid is string && data.remarksByUid.size() <= 128 &&
      data.remarksByName is string && data.remarksByName.size() <= 150 &&
      data.remarksAtIso is string && data.remarksAtIso.size() <= 60 &&
      data.reviewedByUid is string && data.reviewedByUid.size() <= 128 &&
      data.reviewedByName is string && data.reviewedByName.size() <= 150 &&
      data.reviewedAtIso is string && data.reviewedAtIso.size() <= 60 &&
      data.publishedByUid is string && data.publishedByUid.size() <= 128 &&
      data.publishedByName is string && data.publishedByName.size() <= 150 &&
      data.publishedAtIso is string && data.publishedAtIso.size() <= 60 &&
      data.publishedMasterFileId is string && data.publishedMasterFileId.size() <= 256 &&
      data.publishedMasterVersion is int && data.publishedMasterVersion >= 0 &&
      data.publicationAuditLogId is string && data.publicationAuditLogId.size() <= 128 &&
      data.historyVersionsJson is string && data.historyVersionsJson.size() <= 100000 &&
      data.createdAt is timestamp && data.createdAt <= request.time &&
      data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function dailyBatchIdentityUnchanged(data, oldData) {
      return data.batchId == oldData.batchId &&
        data.userId == oldData.userId &&
        data.submitterUid == oldData.submitterUid &&
        data.countingDate == oldData.countingDate &&
        data.createdAt == oldData.createdAt;
    }

    function dailyBatchContentUnchanged(data, oldData) {
      return dailyBatchIdentityUnchanged(data, oldData) &&
        data.versionNumber == oldData.versionNumber &&
        data.recordCount == oldData.recordCount &&
        data.foundCount == oldData.foundCount &&
        data.notFoundCount == oldData.notFoundCount &&
        data.notAccessibleCount == oldData.notAccessibleCount &&
        data.manualEntryCount == oldData.manualEntryCount &&
        data.recordsJson == oldData.recordsJson &&
        data.historyVersionsJson == oldData.historyVersionsJson;
    }

    function dailyBatchSubmitterEdit(data, oldData) {
      return request.auth.uid == oldData.submitterUid &&
        oldData.status in ['Draft / In Progress', 'Changes Requested', 'Rejected'] &&
        data.status in ['Draft / In Progress', 'Submitted / Pending Review'] &&
        dailyBatchIdentityUnchanged(data, oldData) &&
        data.reviewedByUid == oldData.reviewedByUid &&
        data.reviewedByName == oldData.reviewedByName &&
        data.reviewedAtIso == oldData.reviewedAtIso &&
        data.publishedByUid == oldData.publishedByUid &&
        data.publishedByName == oldData.publishedByName &&
        data.publishedAtIso == oldData.publishedAtIso &&
        data.publishedMasterFileId == oldData.publishedMasterFileId &&
        data.publishedMasterVersion == oldData.publishedMasterVersion &&
        data.publicationAuditLogId == oldData.publicationAuditLogId &&
        data.diff(oldData).affectedKeys().hasOnly([
          'submitterFullName', 'submitterNickname', 'recordCount', 'foundCount',
          'notFoundCount', 'notAccessibleCount', 'manualEntryCount', 'status',
          'approvalStatus', 'masterSyncStatus', 'dailySheetDriveFileId',
          'recordsJson', 'versionNumber', 'updatedAt'
        ]) &&
        (
          (oldData.status == 'Draft / In Progress' && data.versionNumber == oldData.versionNumber) ||
          (oldData.status in ['Changes Requested', 'Rejected'] &&
           data.status == 'Submitted / Pending Review' && data.versionNumber == oldData.versionNumber + 1)
        );
    }

    function dailyBatchReviewTransition(data, oldData, workspaceId) {
      return data.status in ['Under Review', 'Changes Requested', 'Rejected'] &&
        oldData.status in ['Submitted / Pending Review', 'Corrected / Resubmitted', 'Under Review'] &&
        canReviewWorkspace(workspaceId) &&
        dailyBatchContentUnchanged(data, oldData) &&
        data.publishedByUid == oldData.publishedByUid &&
        data.publishedByName == oldData.publishedByName &&
        data.publishedAtIso == oldData.publishedAtIso &&
        data.publishedMasterFileId == oldData.publishedMasterFileId &&
        data.publishedMasterVersion == oldData.publishedMasterVersion &&
        data.publicationAuditLogId == oldData.publicationAuditLogId &&
        data.diff(oldData).affectedKeys().hasOnly([
          'status', 'approvalStatus', 'masterSyncStatus', 'masterSyncJobId', 'masterSyncError',
          'adminRemarks', 'remarksByUid', 'remarksByName', 'remarksAtIso',
          'reviewedByUid', 'reviewedByName', 'reviewedAtIso', 'updatedAt'
        ]) &&
        (
          (data.status == 'Under Review' && data.reviewedByUid == request.auth.uid &&
           data.reviewedByName.size() > 0 && data.reviewedAtIso.size() > 0) ||
          (data.status in ['Changes Requested', 'Rejected'] && data.remarksByUid == request.auth.uid &&
           data.remarksByName.size() > 0 && data.remarksAtIso.size() > 0)
        );
    }

    function dailyBatchPublishFailure(data, oldData, workspaceId) {
      return data.status == 'Sync Failed' &&
        oldData.status in ['Under Review', 'Approved - Awaiting Master Update', 'Approved — Awaiting Master Update', 'Sync Failed'] &&
        canPublishAndSync(workspaceId) &&
        dailyBatchContentUnchanged(data, oldData) &&
        data.reviewedByUid == oldData.reviewedByUid &&
        data.reviewedByName == oldData.reviewedByName &&
        data.reviewedAtIso == oldData.reviewedAtIso &&
        data.publishedByUid == oldData.publishedByUid &&
        data.publishedByName == oldData.publishedByName &&
        data.publishedAtIso == oldData.publishedAtIso &&
        data.publishedMasterFileId == oldData.publishedMasterFileId &&
        data.publishedMasterVersion == oldData.publishedMasterVersion &&
        data.publicationAuditLogId == oldData.publicationAuditLogId &&
        data.diff(oldData).affectedKeys().hasOnly(['status', 'approvalStatus', 'masterSyncStatus', 'masterSyncJobId', 'masterSyncError', 'adminRemarks', 'updatedAt']);
    }

    function dailyBatchPublishSuccess(data, oldData, workspaceId) {
      let settingsPath = /databases/$(database)/documents/users/$(workspaceId)/project_settings/main;
      return data.status == 'Published' &&
        oldData.status in ['Under Review', 'Approved - Awaiting Master Update', 'Approved — Awaiting Master Update', 'Sync Failed'] &&
        canPublishAndSync(workspaceId) &&
        dailyBatchContentUnchanged(data, oldData) &&
        data.reviewedByUid == request.auth.uid &&
        data.publishedByUid == request.auth.uid &&
        data.publishedByName.size() > 0 && data.publishedAtIso.size() > 0 &&
        data.publishedMasterFileId.size() > 0 &&
        data.publishedMasterVersion > oldData.publishedMasterVersion &&
        exists(settingsPath) &&
        data.publishedMasterVersion == get(settingsPath).data.masterWorkbookVersion &&
        data.diff(oldData).affectedKeys().hasOnly([
          'status', 'approvalStatus', 'masterSyncStatus', 'masterSyncJobId', 'masterSyncError',
          'publishedByUid', 'publishedByName', 'publishedAtIso',
          'publishedMasterFileId', 'publishedMasterVersion', 'publicationAuditLogId', 'updatedAt'
        ]) &&
        batchPublicationAuditMatches(data, workspaceId);
    }

    function batchPublicationAuditMatches(data, workspaceId) {
      let auditPath = /databases/$(database)/documents/users/$(workspaceId)/activity_logs/$(data.publicationAuditLogId);
      return data.publicationAuditLogId.size() > 0 &&
        existsAfter(auditPath) &&
        getAfter(auditPath).data.actionType == 'PUBLISH_DAILY_BATCH' &&
        getAfter(auditPath).data.targetId == data.batchId &&
        getAfter(auditPath).data.actorUserId == request.auth.uid &&
        getAfter(auditPath).data.userId == workspaceId;
    }

    function submissionPublicationAuditMatches(data, workspaceId) {
      let auditPath = /databases/$(database)/documents/users/$(workspaceId)/activity_logs/$(data.publishedAuditLogId);
      return data.publishedAuditLogId.size() > 0 &&
        existsAfter(auditPath) &&
        getAfter(auditPath).data.actionType == 'PUBLISH_USER_SUBMISSION' &&
        getAfter(auditPath).data.targetId == data.submissionId &&
        getAfter(auditPath).data.actorUserId == request.auth.uid &&
        getAfter(auditPath).data.userId == workspaceId;
    }

    function submissionContentUnchanged(data, oldData) {
      return data.submitterUid == oldData.submitterUid &&
